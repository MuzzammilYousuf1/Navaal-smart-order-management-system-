{$APP_DOMAIN} {
    # FastAPI backend — API routes, WebSockets, and health check
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /ws {
        reverse_proxy backend:8000
    }
    handle /health {
        reverse_proxy backend:8000
    }

    # React SPA frontend
    handle {
        reverse_proxy frontend:80
    }
}
