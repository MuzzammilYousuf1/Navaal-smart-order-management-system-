# Required for stable login sessions in production. Generate a long random value.
SOF_SECRET_KEY=replace-with-a-long-random-secret
# API key checked on every n8n → FastAPI request
N8N_API_KEY=your-secret-key-here
# Paste your n8n "Out For Delivery" webhook URL here to enable WhatsApp dispatch notifications for B2C orders.
# Leave blank to disable (the dispatch action will still work — notifications are best-effort).
N8N_OFD_WEBHOOK_URL=https://your-n8n-instance/webhook/order-dispatched

# Database Connection (Leave blank to use local SQLite, set PostgreSQL URL in cloud production)
# DATABASE_URL=postgresql://username:password@localhost:5432/navaal_db

# Nightly Business Report SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-system-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=your-system-email@gmail.com
REPORT_RECIPIENT_EMAIL=business-owner-email@gmail.com
REPORT_SEND_TIME=23:50
