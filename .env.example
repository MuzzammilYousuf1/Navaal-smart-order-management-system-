# =============================================================================
# Smart OrderFlow — Environment Variables Reference
# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to version control.
# =============================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=navaal_admin
POSTGRES_PASSWORD=replace_with_a_strong_database_password
POSTGRES_DB=sof_production

# ── Domain Routing (used by Caddy for SSL certificate generation) ──────────────
# The backend API domain
API_DOMAIN=api.yourdomain.com
# The frontend app domain
APP_DOMAIN=orders.yourdomain.com
# The n8n automation domain
N8N_DOMAIN=n8n.yourdomain.com

# ── CORS (Cross-Origin Resource Sharing) ──────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=https://orders.yourdomain.com,http://localhost:5173

# ── FastAPI Security ───────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SOF_SECRET_KEY=replace_with_a_64_char_random_hex_string

# ── n8n Webhook Authentication ─────────────────────────────────────────────────
# Shared secret between FastAPI and n8n. Use a strong random string.
N8N_API_KEY=replace_with_your_n8n_shared_api_key

# ── n8n Dispatch Webhook ───────────────────────────────────────────────────────
# The n8n webhook URL to trigger WhatsApp notifications on Out For Delivery
N8N_OFD_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/order-dispatched

# ── n8n Encryption ────────────────────────────────────────────────────────────
# Required by n8n to encrypt stored credentials. Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_n8n

# ── Daily Business Report SMTP (Gmail App Password) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
# Create at: Google Account → Security → 2-Step Verification → App Passwords
SMTP_PASSWORD=your-16-character-gmail-app-password
SMTP_FROM_EMAIL=your-gmail@gmail.com
REPORT_RECIPIENT_EMAIL=owner@yourdomain.com
# 24h time format HH:MM — when to send the nightly report (UTC+5 adjustments apply)
REPORT_SEND_TIME=23:50

# ── WhatsApp / Meta Cloud API (for n8n WhatsApp integration) ──────────────────
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_ACCESS_TOKEN=your_meta_permanent_access_token
META_VERIFY_TOKEN=your_webhook_verify_token

# ── AI / LLM Keys (for n8n AI agent) ─────────────────────────────────────────
GROQ_API_KEY=gsk_replace_with_your_groq_api_key
GEMINI_API_KEY=replace_with_your_google_gemini_api_key

# ── Optional: S3/R2 Backup Storage ────────────────────────────────────────────
# Leave blank to skip cloud upload; backups remain local only.
S3_BUCKET=s3://your-bucket/sof-backups
AWS_ACCESS_KEY_ID=replace_with_access_key
AWS_SECRET_ACCESS_KEY=replace_with_secret_key
AWS_DEFAULT_REGION=auto
# For Cloudflare R2 only:
# AWS_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
